{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.py": {
      "runtime": "python3.12",
      "maxDuration": 30,
      "includeFiles": "backend/**"
    }
  },
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "/api/index.py"
    },
    {
      "src": "^/api$",
      "dest": "/api/index.py"
    },
    {
      "src": "^/assets/(.*)$",
      "dest": "/frontend/dist/assets/$1"
    },
    {
      "src": "^/favicon.svg$",
      "dest": "/frontend/dist/favicon.svg"
    },
    {
      "src": "^/icons.svg$",
      "dest": "/frontend/dist/icons.svg"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/dist/index.html"
    }
  ]
}
